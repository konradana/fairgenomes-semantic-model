<https://w3id.org/fair-genomes/ontology/Biomarker_Subtype_Physiological_Asked_but_unknown_(ASKU,_nullflavor)>
  a <https://w3id.org/fair-genomes/resource/FG_0000770>;
  rdfs:label "Asked but unknown (ASKU, nullflavor)";
