fg:Biomarker_Subtype_Physiological_Blood_Pressure a <https://w3id.org/fair-genomes/resource/FG_0000770>;
  rdfs:label "Blood Pressure";
  dc:description "The pressure of the circulating blood against the walls of the blood vessels.";
  rdfs:isDefinedBy obo:NCIT_C54706 .

fg:Biomarker_Subtype_Physiological_Ankle-brachial_Index a <https://w3id.org/fair-genomes/resource/FG_0000770>;
  rdfs:label "Ankle-brachial Index";
  dc:description "The ratio of ankle systolic pressure to brachial systolic pressure, used to assess arterial insufficiency in the lower extremities.";
  rdfs:isDefinedBy obo:NCIT_C87304 .

fg:Biomarker_Subtype_Physiological_ECG a <https://w3id.org/fair-genomes/resource/FG_0000770>;
  rdfs:label "ECG";
  dc:description "A procedure that displays the electrical activity of the heart.";
  rdfs:isDefinedBy obo:NCIT_C38053 .

fg:Biomarker_Subtype_Physiological_EEG a <https://w3id.org/fair-genomes/resource/FG_0000770>;
  rdfs:label "EEG";
  dc:description "The neurophysiologic exploration of the electrical activity of the brain by the application of electrodes to the scalp. The resulting traces are known as an electroencephalogram (EEG). This test is used to assess brain damage, epilepsy and other problems.";
  rdfs:isDefinedBy obo:NCIT_C38054 .

fg:Biomarker_Subtype_Physiological_Electromyography a <https://w3id.org/fair-genomes/resource/FG_0000770>;
  rdfs:label "Electromyography";
  dc:description "An assessment of skeletal muscle function and nerve control, obtained by recording and studying the intrinsic electrical properties of the muscles.";
  rdfs:isDefinedBy obo:NCIT_C38056 .

<https://w3id.org/fair-genomes/ontology/Biomarker_Subtype_Physiological_NoInformation_(NI,_nullflavor)>
  a <https://w3id.org/fair-genomes/resource/FG_0000770>;
  rdfs:label "NoInformation (NI, nullflavor)";
  dc:description "The value is exceptional (missing, omitted, incomplete, improper). No information as to the reason for being an exceptional value is provided. This is the most general exceptional value. It is also the default exceptional value.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#NI> .

<https://w3id.org/fair-genomes/ontology/Biomarker_Subtype_Physiological_Invalid_(INV,_nullflavor)>
  a <https://w3id.org/fair-genomes/resource/FG_0000770>;
  rdfs:label "Invalid (INV, nullflavor)";
  dc:description "The value as represented in the instance is not a member of the set of permitted data values in the constrained value domain of a variable.";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#INV> .

<https://w3id.org/fair-genomes/ontology/Biomarker_Subtype_Physiological_Derived_(DER,_nullflavor)>
  a <https://w3id.org/fair-genomes/resource/FG_0000770>;
  rdfs:label "Derived (DER, nullflavor)";
  dc:description "An actual value may exist, but it must be derived from the provided information (usually an EXPR generic data type extension will be used to convey the derivation expression .";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#DER> .

<https://w3id.org/fair-genomes/ontology/Biomarker_Subtype_Physiological_Other_(OTH,_nullflavor)>
  a <https://w3id.org/fair-genomes/resource/FG_0000770>;
  rdfs:label "Other (OTH, nullflavor)";
  dc:description "The actual value is not a member of the set of permitted data values in the constrained value domain of a variable.The actual value is not a member of the set of permitted data values in the constrained value domain of a variable. (e.g., concept not provided by required code system).";
  rdfs:isDefinedBy <http://terminology.hl7.org/CodeSystem/v3-NullFlavor#OTH> .

